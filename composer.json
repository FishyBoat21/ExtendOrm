{
  "name": "fishyboat21/extendorm",
  "description": "Simple Lightweight CRUD ORM for PHP 8.1+",
  "type": "library",
  "keywords": ["orm", "database", "pdo", "crud", "php", "lightweight"],
  "homepage": "https://github.com/FishyBoat21/ExtendOrm",
  "license": "MIT",
  "authors": [
    {
      "name": "FishyBoat21",
      "homepage": "https://github.com/FishyBoat21"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*"
  },
  "require-dev": {
    "ext-pdo_sqlite": "*",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "FishyBoat21\\ExtendOrm\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FishyBoat21\\ExtendOrm\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --no-progress"
  },
  "config": {
    "sort-packages": true
  },
  "extra": {
    "branch-alias": {
      "dev-main": "2.0.x-dev"
    }
  },
  "support": {
    "issues": "https://github.com/FishyBoat21/ExtendOrm/issues",
    "source": "https://github.com/FishyBoat21/ExtendOrm"
  },
  "minimum-stability": "stable"
}
